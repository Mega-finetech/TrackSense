{
  "expo": {
    "name": "TrackSense",
    "slug": "tracksense",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "tracksense",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tracksense.app"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.tracksense.app"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/branding/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/branding/icon.png",
          "imageWidth": 100,
          "backgroundColor": "#F6F8F5",
          "dark": {
            "backgroundColor": "#101D19"
          }
        }
      ],
      "expo-font",
      "expo-status-bar",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "cameraPermission": "TrackSense uses your camera to take a profile photo.",
          "photosPermission": "TrackSense uses your photos to set a profile picture.",
          "microphonePermission": false
        }
      ],
      "expo-notifications"
    ]
  }
}
